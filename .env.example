VITE_GATEWAY_URL=http://localhost:3000

# Enable only after PATCH /api/businesses/:businessId and profile schema fields are deployed.
VITE_BUSINESS_PROFILE_UPDATE_ENABLED=false

# Prototype only: enable after secure tenant binding or a widget token is deployed.
VITE_WEB_CHAT_ENABLED=false

# Enable only after the gateway notification list/read endpoints are deployed.
VITE_NOTIFICATION_CENTER_ENABLED=false

# Enable image selection/upload only when secure gateway media storage is deployed.
VITE_IMAGE_ATTACHMENTS_ENABLED=false

# Enable only for the prototype agent identity flow; production requires authenticated tenant membership.
VITE_AGENT_ESCALATION_QUEUE_ENABLED=false
